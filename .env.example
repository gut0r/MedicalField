# Copie para .env apenas no ambiente local. Nunca versione senhas reais.
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8080

# PostgreSQL central
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=medicalfield
DATABASE_USER=medicalfield_app
DATABASE_PASSWORD=change-me
DATABASE_URL=postgresql://medicalfield_app:change-me@localhost:5432/medicalfield

# JWT assimétrico. Em produção, aponte para arquivos protegidos fora do repositório.
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ISSUER=medicalfield-auth
JWT_AUDIENCE=medicalfield-services
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=12
OFFLINE_GRANT_HOURS=12

# URLs internas entre serviços
AUTH_SERVICE_URL=http://127.0.0.1:8001
PATIENT_SERVICE_URL=http://127.0.0.1:8081
MEDICAL_RECORD_SERVICE_URL=http://127.0.0.1:3001
MEDICATION_SERVICE_URL=http://127.0.0.1:8002
SYNC_SERVICE_URL=http://127.0.0.1:8082
DOCUMENT_SERVICE_URL=http://127.0.0.1:3002

# SMTP de demonstração. Use credencial de aplicativo, nunca a senha pessoal.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASSWORD=change-me
SMTP_FROM=MedicalField <no-reply@example.com>

# Front-ends
VITE_API_BASE_URL=/api
VITE_FIELD_CLIENT_URL=/field/

