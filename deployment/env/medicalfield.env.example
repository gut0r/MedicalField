APP_ENV=production
DATABASE_URL=postgresql://medicalfield_app:change-me@127.0.0.1:5432/medicalfield
JDBC_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/medicalfield
DATABASE_USER=medicalfield_app
DATABASE_PASSWORD=change-me
JWT_PRIVATE_KEY_PATH=/opt/medicalfield/secrets/jwt-private.pem
